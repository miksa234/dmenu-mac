#!/bin/sh

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

choice=$("$script_dir/dmenu-mac_path" | "$script_dir/dmenu-mac" -i "$@")
status=$?

[ "$status" -eq 0 ] || exit "$status"
[ -n "$choice" ] || exit 1

case "$choice" in
*.app)
  exec open "$choice"
  ;;
*)
  exec "$choice"
  ;;
esac
